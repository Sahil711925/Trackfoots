{
  "name": "trackfoots",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Tamper-evident log integrity: hash-chained logs whose Merkle roots are anchored to a public ledger, so a root-level attacker cannot rewrite history.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "anchor": "node scripts/anchor.js",
    "verify": "node cli.js verify",
    "attack": "node scripts/attack.js",
    "ui": "node server.js",
    "reset": "node scripts/reset.js",
    "wallet": "node scripts/wallet.js",
    "deploy": "node scripts/deploy.js",
    "verify:chain": "node scripts/verify-chain.js",
    "liveness": "node scripts/check-liveness.js",
    "consistency": "node scripts/check-consistency.js",
    "auditor": "node scripts/auditor.js",
    "verify:receipts": "node scripts/verify-receipts.js",
    "import": "node scripts/import-logs.js",
    "seed:real": "node scripts/seed-real.js",
    "bench": "node scripts/bench.js",
    "retention": "node scripts/retention.js",
    "incident": "node scripts/incident-report.js",
    "test": "node --test tests/*.test.js",
    "prove": "node scripts/prove.js",
    "bundle": "node scripts/export-bundle.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.39"
  }
}
